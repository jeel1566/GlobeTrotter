# GlobeTrotter AI Travel Platform - Environment Variables Template
# Copy this file to .env.local and fill in your keys

# Clerk Authentication (Get from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Clerk Frontend Path Routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Supabase Postgres & Auth (Get from https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional AI Providers (System includes hand-curated fallback templates + 8s circuit breaker)
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIzaSy...

# Admin Authorization (comma-separated admin emails granted access to /admin telemetry)
ADMIN_EMAILS=admin@example.com

# OpenStreetMap / Photon Geocoding & High-res Unsplash imagery require no paid API keys.
